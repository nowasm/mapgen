{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mapgen.local/schema/dungeon-layout-v1.json",
  "title": "Mapgen Dungeon Layout v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "generatorVersion",
    "exportId",
    "seed",
    "parameters",
    "grid",
    "coordinateSystem",
    "assetPack",
    "rooms",
    "connections",
    "corridors",
    "doors",
    "spawn",
    "modules",
    "colliders",
    "diagnostics"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatorVersion": { "type": "string", "minLength": 1 },
    "exportId": { "type": "string", "minLength": 1 },
    "seed": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
    "parameters": { "type": "object" },
    "grid": { "type": "object" },
    "coordinateSystem": { "type": "object" },
    "assetPack": { "type": "object" },
    "rooms": { "type": "array" },
    "connections": { "type": "array" },
    "corridors": { "type": "array" },
    "doors": { "type": "array" },
    "spawn": { "type": "object" },
    "modules": { "type": "array" },
    "colliders": { "type": "array" },
    "diagnostics": { "type": "object" }
  },
  "additionalProperties": false
}
